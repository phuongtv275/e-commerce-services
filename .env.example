# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ==============================================================================
# CACHE & IN-MEMORY (Redis)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ==============================================================================
# MESSAGE BROKER (Kafka)
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=8089

# ==============================================================================
# SEARCH ENGINE (Elasticsearch)
# ==============================================================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ==============================================================================
# MAIL SERVICE (MailHog for local dev / SMTP for production)
# ==============================================================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ecom.local
MAIL_DEFAULT_ENCODING=UTF-8
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_SMTP_READ_TIMEOUT_MS=10000
MAIL_SMTP_WRITE_TIMEOUT_MS=10000

# ==============================================================================
# SPRING CLOUD INFRASTRUCTURE
# ==============================================================================
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/
SPRING_PROFILES_ACTIVE=dev

# ==============================================================================
# INTER-SERVICE HOST URLS (For bare-metal / IDE execution)
# Note: In Docker Compose, these are overridden to container service names.
# ==============================================================================
IDENTITY_SERVICE_URL=localhost:8081
CATALOG_SERVICE_URL=localhost:8082
INVENTORY_SERVICE_URL=localhost:8083
ORDER_SERVICE_URL=localhost:8084
PAYMENT_SERVICE_URL=localhost:8085
NOTIFICATION_SERVICE_URL=localhost:8086

# ==============================================================================
# SECURITY & AUTHENTICATION (Never commit real values in git)
# ==============================================================================
JWT_SECRET=your_production_hmac_secret_key_minimum_256_bits_here
GATEWAY_ASSERTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_2048_private_key_here\n-----END PRIVATE KEY-----"
GATEWAY_ASSERTION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour_rsa_2048_public_key_here\n-----END PUBLIC KEY-----"
INTERNAL_KEY_ORDER=your_order_service_internal_secret_32_chars_min
INTERNAL_KEY_NOTIFICATION=your_notification_service_internal_secret_32_chars_min
INTERNAL_KEY_PAYMENT=your_payment_service_internal_secret_32_chars_min

# ==============================================================================
# PAYMENT GATEWAY (VNPAY Sandbox)
# ==============================================================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_IPN_URL=https://your-public-domain/api/v1/payments/vnpay/ipn
VNPAY_RETURN_URL=https://your-frontend-domain/payment/return
VNPAY_IP_ADDRESS=127.0.0.1
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_VERSION=2.1.0
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
VNPAY_EXPIRE_MINUTES=15
