# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=rikkeiacademy

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=8089

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# MailHog Configuration
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Spring Cloud Config & Eureka Configuration
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/

# Application Environment Profile (Set 'production' for production deployments)
SPRING_PROFILES_ACTIVE=production

# Security & JWT Configuration (Must be explicitly customized for production deployment)
JWT_SECRET=your_production_hmac_secret_key_minimum_256_bits_here
GATEWAY_ASSERTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_2048_private_key_here\n-----END PRIVATE KEY-----"
GATEWAY_ASSERTION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour_rsa_2048_public_key_here\n-----END PUBLIC KEY-----"
INTERNAL_KEY_ORDER=your_order_service_internal_secret_32_chars_min
INTERNAL_KEY_NOTIFICATION=your_notification_service_internal_secret_32_chars_min

